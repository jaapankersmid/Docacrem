(($F{tussenvoegsel}!=null&&$F{tussenvoegsel}.length()>0)?$F{tussenvoegsel} + " ":"") +
$F{achternaam}.substring(0, 1).toUpperCase() + $F{achternaam}.substring(1)]]></variableExpression>
	</variable>
	<variable name="adres" class="java.lang.String">
		<variableExpression><![CDATA[(($F{straat} != null && $F{straat}.length() > 1)?$F{straat}.substring(0, 1).toUpperCase() + $F{straat}.substring(1):"") + " " + (($F{huisnummer}!=null)?$F{huisnummer}:"")]]></variableExpression>
	</variable>
	<variable name="postcode_woonplaats" class="java.lang.String">
		<variableExpression><![CDATA[(($F{postcode} != null)?$F{postcode}.toUpperCase():"") + " " + (($F{woonplaats} != null && $F{woonplaats}.length() > 1)?$F{woonplaats}.substring(0, 1).toUpperCase() + $F{woonplaats}.substring(1):"")]]></variableExpression>
