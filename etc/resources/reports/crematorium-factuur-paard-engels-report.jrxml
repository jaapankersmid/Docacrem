	<variable name="klantnaam" class="java.lang.String">
		<variableExpression><![CDATA[(($F{aanhef}!=null&&$F{aanhef}.length()>0)?$F{aanhef} + " ":"") +
(($F{voorletters}!=null&&$F{voorletters}.length()>0)?$F{voorletters} + " ":"") +
(($F{tussenvoegsel}!=null&&$F{tussenvoegsel}.length()>0)?$F{tussenvoegsel} + " ":"") +
$F{achternaam}.substring(0, 1).toUpperCase() + $F{achternaam}.substring(1)]]></variableExpression>
	</variable>
	<variable name="adres" class="java.lang.String">
		<variableExpression><![CDATA[(($F{straat} != null && $F{straat}.length() > 1)?$F{straat}.substring(0, 1).toUpperCase() + $F{straat}.substring(1):"") + " " + (($F{huisnummer}!=null)?$F{huisnummer}:"")]]></variableExpression>
	</variable>
	<variable name="postcode_woonplaats" class="java.lang.String">
		<variableExpression><![CDATA[(($F{postcode} != null)?$F{postcode}.toUpperCase():"") + " " + (($F{woonplaats} != null && $F{woonplaats}.length() > 1)?$F{woonplaats}.substring(0, 1).toUpperCase() + $F{woonplaats}.substring(1):"")]]></variableExpression>
	</variable>
	<variable name="crematie_prijs" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal($F{crematie_prijs}.doubleValue() - ($F{crematie_prijs}.doubleValue()/(100+$F{btw_percentage}.doubleValue())) * $F{btw_percentage}.doubleValue())]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="kosten_vervoer" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal($F{kosten_vervoer}.doubleValue() - ($F{kosten_vervoer}.doubleValue()/(100+$F{btw_percentage}.doubleValue())) * $F{btw_percentage}.doubleValue())]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="box" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal($F{box}.doubleValue() - ($F{box}.doubleValue()/(100+$F{btw_percentage}.doubleValue())) * $F{btw_percentage}.doubleValue())]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="as_in_urn" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal($F{as_in_urn}.doubleValue() - ($F{as_in_urn}.doubleValue()/(100+$F{btw_percentage}.doubleValue())) * $F{btw_percentage}.doubleValue())]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="as_verstrooing" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal($F{as_verstrooing}.doubleValue() - ($F{as_verstrooing}.doubleValue()/(100+$F{btw_percentage}.doubleValue())) * $F{btw_percentage}.doubleValue())]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="extra_kosten" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal($F{extra_kosten}.doubleValue())]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="gedenkplaat" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal($F{gedenkplaat}.doubleValue() - ($F{gedenkplaat}.doubleValue()/(100+$F{btw_percentage}.doubleValue())) * $F{btw_percentage}.doubleValue())]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="administratie_kosten" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal($F{administratie_kosten}.doubleValue() - ($F{administratie_kosten}.doubleValue()/(100+$F{btw_percentage}.doubleValue())) * $F{btw_percentage}.doubleValue())]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="sieraden" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal($F{sieraden}.doubleValue() - ($F{sieraden}.doubleValue()/(100+$F{btw_percentage}.doubleValue())) * $F{btw_percentage}.doubleValue())]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
