	<parameter name="datum" isForPrompting="false" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT eigenaar.aanhef AS eigenaar_aanhef, eigenaar.achternaam AS eigenaar_achternaam, eigenaar.tussenvoegsel AS eigenaar_tussenvoegsel, eigenaar.voorletters AS eigenaar_voorletters, adres.straat AS eigenaar_straat, adres.huisnummer AS eigenaar_huisnummer, adres.postcode AS eigenaar_postcode, adres.woonplaats AS eigenaar_woonplaats, contact.telefoonnummer AS eigenaar_telefoonnummer, 
	vang_kooien.nummer AS vang_kooi_nummer, datum_plaatsing, datum_retour_vang_kooi, datum_retour_borg, aantal_vang_kooien, borg, omschrijving
FROM asiel_eigenaren as eigenaar
INNER JOIN adres ON eigenaar.adres_id=adres.adres_id
INNER JOIN contact ON eigenaar.contact_id=contact.contact_id
INNER JOIN asiel_eigenaar_vang_kooien ON eigenaar.asiel_eigenaar_id=asiel_eigenaar_vang_kooien.asiel_eigenaar_id 
INNER JOIN vang_kooien ON asiel_eigenaar_vang_kooien.vang_kooi_id=vang_kooien.vang_kooi_id
WHERE vang_kooien.datum_retour_vang_kooi IS NULL OR vang_kooien.datum_retour_vang_kooi > $P{datum}]]></queryString>

