	<parameter name="factuur_id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[new java.lang.Long( 0 )]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT creche_factuur_id AS factuur_nummer, product_naam, product_aantal, product_prijs, product_btw, (product_prijs*product_aantal) AS product_totaal, ((product_prijs*product_aantal)/(product_btw+100)*product_btw) AS product_btw_prijs
FROM creche_factuur_regel_producten
WHERE creche_factuur_id=$P{factuur_id}
ORDER BY product_naam]]>
	</queryString>
	<field name="factuur_nummer" class="java.lang.Long"/>
	<field name="product_naam" class="java.lang.String"/>
