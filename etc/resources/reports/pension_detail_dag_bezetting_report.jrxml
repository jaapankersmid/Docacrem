<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="asiel_detail_dag_bezetting_report" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="bezetting_datum" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="diersoort_naam" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Hond"]]></defaultValueExpression>
	</parameter>
	<parameter name="extra_diersoort_naam" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT k.voorletters, k.tussenvoegsel, k.achternaam,
  d.naam AS diernaam, d.geslacht, d.gecastreerd, d.kruising, d.kleur, d.geboortedatum, r.naam AS rasnaam, ds.naam AS diersoortnaam
FROM facturen AS f
  INNER JOIN klanten AS k ON k.klant_id = f.klant_id
  INNER JOIN factuur_regels AS fr ON fr.factuur_id = f.factuur_id
  INNER JOIN dieren AS d ON fr.dier_id = d.dier_id
  INNER JOIN rassen AS r ON r.ras_id = d.ras_id
  INNER JOIN diersoort AS ds ON ds.diersoort_id = r.diersoort_id
WHERE f.geannuleerd IS FALSE
  AND f.gereserveerd_van <= $P{bezetting_datum}
  AND f.gereserveerd_tot >= $P{bezetting_datum}
  AND ($P{diersoort_naam} = ' - '
      OR ($P{diersoort_naam} IN ('Hond','Kat') AND ds.naam = $P{diersoort_naam})
      OR ($P{diersoort_naam} IN ('Overig') AND ds.naam NOT IN ('Hond','Kat')))
ORDER BY f.gereserveerd_van, k.achternaam, d.naam]]>
	</queryString>
	<field name="voorletters" class="java.lang.String"/>
	<field name="tussenvoegsel" class="java.lang.String"/>
	<field name="achternaam" class="java.lang.String"/>
	<field name="diernaam" class="java.lang.String"/>
	<field name="geslacht" class="java.lang.String"/>
	<field name="gecastreerd" class="java.lang.Boolean"/>
	<field name="kruising" class="java.lang.Boolean"/>
	<field name="kleur" class="java.lang.String"/>
	<field name="geboortedatum" class="java.sql.Date"/>
	<field name="rasnaam" class="java.lang.String"/>
	<field name="diersoortnaam" class="java.lang.String"/>
	<variable name="totMan" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[(($F{geslacht}.equalsIgnoreCase("Mannelijk") && !$F{gecastreerd}) ? 1 : 0)]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="totManG" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[(($F{geslacht}.equalsIgnoreCase("Mannelijk") && $F{gecastreerd}) ? 1 : 0)]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="totVrouw" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[(($F{geslacht}.equalsIgnoreCase("Vrouwelijk") && !$F{gecastreerd}) ? 1 : 0)]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="totVrouwG" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[(($F{geslacht}.equalsIgnoreCase("Vrouwelijk") && $F{gecastreerd}) ? 1 : 0)]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
