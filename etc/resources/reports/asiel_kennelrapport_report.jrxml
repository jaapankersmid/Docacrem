	<parameter name="asiel_verblijf_id" isForPrompting="true" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="organisatie_naam" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Demopension"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT DISTINCT asiel_verblijven.verblijf_nummer, asiel_verblijven.vindplaats, asiel_verblijven.opname_datum, asiel_verblijven.opmerkingen_extern, asiel_verblijven.reden_afstand AS verblijf_reden_afstand, 
       asiel_dieren.identificatie_nummer AS registratienr, asiel_dieren.naam AS diernaam, asiel_dieren.chip_pasnummer AS tattoeage_chip, asiel_dieren.kleur, asiel_dieren.kenmerken, asiel_dieren.geslacht, asiel_dieren.gecastreerd, asiel_dieren.geboortedatum, asiel_dieren.kruising, rassen.naam AS rasnaam, diersoort.naam AS diersoortnaam, laatste_loopsheid_krolsheid, gedrag, bijzonderheden, 
       dier_vachten.naam AS vachtnaam, 
       gemeenten.naam AS gemeente,
       asiel_opname_soorten.naam AS reden_afstand, 
       (SELECT min(afbeelding) 
        FROM afbeeldingen
        INNER JOIN asiel_dier_afbeeldingen ON afbeeldingen.afbeelding_id=asiel_dier_afbeeldingen.afbeelding_id
        WHERE asiel_dier_afbeeldingen.dier_id=asiel_dieren.asiel_dier_id) AS dier_afbeelding
FROM asiel_verblijven
  JOIN asiel_dieren ON asiel_dieren.asiel_dier_id=asiel_verblijven.asiel_dier_id
  LEFT JOIN gemeenten ON asiel_verblijven.gemeente_id=gemeenten.gemeente_id
  LEFT JOIN rassen ON asiel_dieren.ras_id=rassen.ras_id
  LEFT JOIN diersoort ON rassen.diersoort_id=diersoort.diersoort_id
  LEFT JOIN voeding ON asiel_dieren.voeding_id=voeding.voeding_id
  LEFT JOIN lichaamelijk ON asiel_dieren.lichaamelijk_id=lichaamelijk.lichaamelijk_id
  LEFT JOIN dier_vachten ON asiel_dieren.dier_vacht_id=dier_vachten.dier_vacht_id
  LEFT JOIN asiel_opname_soorten ON asiel_verblijven.asiel_opname_soort_id=asiel_opname_soorten.opname_soort_id
WHERE asiel_verblijven.verblijf_nummer=$P{asiel_verblijf_id}]]></queryString>

