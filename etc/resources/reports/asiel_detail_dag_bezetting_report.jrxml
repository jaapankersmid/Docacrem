	<variable name="totMan" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[(($F{geslacht}.equalsIgnoreCase("Mannelijk") && !$F{gecastreerd}) ? 1 : 0)]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
