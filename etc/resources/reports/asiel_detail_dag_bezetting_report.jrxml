	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="bezetting_datum" class="java.util.Date" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="diersoort_naam" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Hond"]]></defaultValueExpression>
	</parameter>
	<parameter name="extra_diersoort_naam" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT asiel_dieren.identificatie_nummer AS registratie_nummer, asiel_dieren.naam AS diernaam, asiel_dieren.geslacht, asiel_dieren.gecastreerd, asiel_dieren.kruising, asiel_dieren.kleur, asiel_dieren.geboortedatum,
  asiel_verblijven.opname_datum, asiel_verblijven.halsband_nummer,
  rassen.naam AS rasnaam, diersoort.naam AS diersoortnaam,
  asiel_opname_soorten.naam AS Reden_opname,
  asiel_verblijf_statussen.naam AS verblijf_status
FROM asiel_verblijven
  INNER JOIN asiel_dieren ON asiel_verblijven.asiel_dier_id=asiel_dieren.asiel_dier_id
  INNER JOIN rassen ON asiel_dieren.ras_id=rassen.ras_id
  INNER JOIN diersoort ON rassen.diersoort_id=diersoort.diersoort_id
  LEFT JOIN asiel_opname_soorten ON asiel_verblijven.asiel_opname_soort_id=asiel_opname_soorten.opname_soort_id
  LEFT JOIN asiel_verblijf_statussen ON asiel_verblijven.asiel_verblijf_status_id=asiel_verblijf_statussen.verblijf_status_id
WHERE NOT asiel_verblijven.opname_datum IS NULL
  AND asiel_verblijven.opname_datum<=$P{bezetting_datum}
  AND (asiel_verblijven.vertrek_datum IS NULL OR asiel_verblijven.vertrek_datum>$P{bezetting_datum})
  AND (diersoort.naam=$P{diersoort_naam} OR diersoort.naam=$P{extra_diersoort_naam})
ORDER BY asiel_verblijven.opname_datum]]>
	</queryString>
