	<queryString><![CDATA[select inkomsten.*, uitgaven.kas_uit, uitgaven.bank_uit
from kasboek
left join kasboek_overzicht_inkomsten as inkomsten on kasboek.kasboek_id=inkomsten.kasboek_id
left join kasboek_overzicht_uitgaven as uitgaven on kasboek.kasboek_id=uitgaven.kasboek_id
WHERE kasboek.kasboek_id=$P{kasboek_id}]]></queryString>

