				<textFieldExpression class="java.lang.String"><![CDATA[new java.text.SimpleDateFormat("d MMM yyyy").format($F{gereserveerd_van}) +
($P{tijd_voor_de_middag}.length() > 0 && (new java.text.SimpleDateFormat("HH:mm").format($F{gereserveerd_van}).compareTo($P{tijd_voor_de_middag}) < 0)?" - V.M.":"")]]></textFieldExpression>
