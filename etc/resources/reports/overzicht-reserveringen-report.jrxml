($P{tijd_na_de_middag}.length() > 0 && (new java.text.SimpleDateFormat("HH:mm").format($F{gereserveerd_tot}).compareTo($P{tijd_na_de_middag}) > 0)?" - N.M.":"")]]></textFieldExpression>
