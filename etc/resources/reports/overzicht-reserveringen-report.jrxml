<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="overzicht-reserveringen-report" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="gereserveerd_van" class="java.util.Date">
		<defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="gereserveerd_tot" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="organisatie_naam" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Demopension"]]></defaultValueExpression>
	</parameter>
	<parameter name="tijd_voor_de_middag" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="tijd_na_de_middag" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT IF(ISNULL(facturen.factuur_nummer),facturen.reservering_nummer,facturen.factuur_nummer) as factuur_nummer, gereserveerd_van, gereserveerd_tot, klanten.achternaam, klanten.voorletters, klanten.tussenvoegsel, klanten.aanhef, dieren.naam AS diernaam, geslacht, rassen.naam AS rasnaam
FROM facturen
  JOIN klanten ON facturen.klant_id=klanten.klant_id
  JOIN factuur_regels ON facturen.factuur_id=factuur_regels.factuur_id
  JOIN dieren ON dieren.dier_id=factuur_regels.dier_id
  JOIN rassen ON rassen.ras_id=dieren.ras_id
WHERE geannuleerd = false AND
     (((verbleven_van IS NULL OR year(verbleven_van) < 1000) AND gereserveerd_van > $P{gereserveerd_van} AND gereserveerd_van < $P{gereserveerd_tot})
  OR (NOT verbleven_van IS NULL AND year(verbleven_van) > 1000 AND verbleven_van > $P{gereserveerd_van} AND verbleven_van < $P{gereserveerd_tot}))
ORDER BY facturen.factuur_nummer]]>
	</queryString>
	<field name="factuur_nummer" class="java.lang.Long"/>
	<field name="gereserveerd_van" class="java.sql.Timestamp"/>
	<field name="gereserveerd_tot" class="java.sql.Timestamp"/>
	<field name="achternaam" class="java.lang.String"/>
	<field name="voorletters" class="java.lang.String"/>
	<field name="tussenvoegsel" class="java.lang.String"/>
	<field name="aanhef" class="java.lang.String"/>
	<field name="diernaam" class="java.lang.String"/>
	<field name="geslacht" class="java.lang.String"/>
	<field name="rasnaam" class="java.lang.String"/>
