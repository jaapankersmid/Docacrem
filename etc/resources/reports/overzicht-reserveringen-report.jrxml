				</box>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.String"><![CDATA["" + $F{factuur_nummer}]]></textFieldExpression>
			</textField>
			<textField pattern="d MMM yyyy" isBlankWhenNull="false">
