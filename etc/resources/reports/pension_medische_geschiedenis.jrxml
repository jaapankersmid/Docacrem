<jasperReport
		 name="pension_medische_geschiedenis"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="asiel_dier_id" isForPrompting="true" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="organisatie_naam" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Demopension"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT klanten.aanhef, klanten.voorletters, klanten.tussenvoegsel, klanten.achternaam, 
       adres.straat, adres.huisnummer, adres.postcode, adres.woonplaats, contact.telefoonnummer, contact.mobielnummer, 
       dieren.identificatie_nummer AS registratienr, dieren.naam AS diernaam, dieren.geslacht, dieren.kleur, dieren.chip_pasnummer,
       rassen.naam AS rasnaam,
       inentingen.naam AS behandeling_naam, inentingen.merk, inentingen.begin_datum, inentingen.eind_datum, '' AS omschrijving
FROM dieren
INNER JOIN klanten ON dieren.klant_id=klanten.klant_id
INNER JOIN adres ON klanten.adres_id=adres.adres_id
INNER JOIN contact ON klanten.contact_id=contact.contact_id
INNER JOIN rassen ON dieren.ras_id=rassen.ras_id
INNER JOIN lichaamelijk ON dieren.lichaamelijk_id=lichaamelijk.lichaamelijk_id
INNER JOIN lichaamelijk_inentingen ON lichaamelijk.lichaamelijk_id=lichaamelijk_inentingen.lichaamelijk_id
INNER JOIN inentingen ON lichaamelijk_inentingen.inenting_id=inentingen.inenting_id
WHERE dieren.dier_id=$P{asiel_dier_id}

UNION

SELECT klanten.aanhef, klanten.voorletters, klanten.tussenvoegsel, klanten.achternaam, 
       adres.straat, adres.huisnummer, adres.postcode, adres.woonplaats, contact.telefoonnummer, contact.mobielnummer, 
       dieren.identificatie_nummer AS registratienr, dieren.naam AS diernaam, dieren.geslacht, dieren.kleur, dieren.chip_pasnummer,
       rassen.naam AS rasnaam,
       medische_handelingen.naam AS behandeling_naam, medische_handelingen.merk, medische_handelingen.begin_datum, medische_handelingen.eind_datum, medische_handelingen.omschrijving
FROM dieren
INNER JOIN klanten ON dieren.klant_id=klanten.klant_id
INNER JOIN adres ON klanten.adres_id=adres.adres_id
INNER JOIN contact ON klanten.contact_id=contact.contact_id
INNER JOIN rassen ON dieren.ras_id=rassen.ras_id
INNER JOIN lichaamelijk ON dieren.lichaamelijk_id=lichaamelijk.lichaamelijk_id
INNER JOIN lichaamelijk_medische_handelingen ON lichaamelijk.lichaamelijk_id=lichaamelijk_medische_handelingen.lichaamelijk_id
INNER JOIN medische_handelingen ON lichaamelijk_medische_handelingen.medische_handeling_id=medische_handelingen.medische_handeling_id
WHERE dieren.dier_id=$P{asiel_dier_id}

UNION

SELECT klanten.aanhef, klanten.voorletters, klanten.tussenvoegsel, klanten.achternaam, 
       adres.straat, adres.huisnummer, adres.postcode, adres.woonplaats, contact.telefoonnummer, contact.mobielnummer, 
       dieren.identificatie_nummer AS registratienr, dieren.naam AS diernaam, dieren.geslacht, dieren.kleur, dieren.chip_pasnummer,
       rassen.naam AS rasnaam,
       medicijnen.naam AS behandeling_naam, '' AS merk, medicijnen.begin_datum, medicijnen.eind_datum, medicijnen.omschrijving
FROM dieren
INNER JOIN klanten ON dieren.klant_id=klanten.klant_id
INNER JOIN adres ON klanten.adres_id=adres.adres_id
INNER JOIN contact ON klanten.contact_id=contact.contact_id
INNER JOIN rassen ON dieren.ras_id=rassen.ras_id
INNER JOIN lichaamelijk ON dieren.lichaamelijk_id=lichaamelijk.lichaamelijk_id
INNER JOIN lichaamelijk_medicijnen ON lichaamelijk.lichaamelijk_id=lichaamelijk_medicijnen.lichaamelijk_id
INNER JOIN medicijnen ON lichaamelijk_medicijnen.medicijn_id=medicijnen.medicijn_id
WHERE dieren.dier_id=$P{asiel_dier_id}

ORDER BY begin_datum]]></queryString>

