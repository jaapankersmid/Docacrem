<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="overzicht-reserveringstijden-report"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="gereserveerd_van" isForPrompting="true" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="gereserveerd_tot" isForPrompting="true" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="organisatie_naam" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Demopension"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT IF(ISNULL(facturen.factuur_nummer),facturen.reservering_nummer,facturen.factuur_nummer) as factuur_nummer, klanten.voorletters, klanten.achternaam, gereserveerd_van, gereserveerd_tot, dieren.naam AS diernaam, geslacht, rassen.naam AS rasnaam  
FROM facturen
  JOIN klanten ON klanten.klant_id=facturen.klant_id
  JOIN factuur_regels ON facturen.factuur_id=factuur_regels.factuur_id
  JOIN dieren ON dieren.dier_id=factuur_regels.dier_id
  JOIN rassen ON rassen.ras_id=dieren.ras_id
WHERE geannuleerd = false AND 
     (((verbleven_van IS NULL OR year(verbleven_van) < 1000) AND gereserveerd_van > $P{gereserveerd_van} AND gereserveerd_van < $P{gereserveerd_tot})
  OR (NOT verbleven_van IS NULL AND year(verbleven_van) > 1000 AND verbleven_van > $P{gereserveerd_van} AND verbleven_van < $P{gereserveerd_tot}))
ORDER BY gereserveerd_van, klanten.achternaam, dieren.naam]]></queryString>

	<field name="factuur_nummer" class="java.lang.Long"/>
	<field name="voorletters" class="java.lang.String"/>
	<field name="achternaam" class="java.lang.String"/>
	<field name="gereserveerd_van" class="java.sql.Timestamp"/>
	<field name="gereserveerd_tot" class="java.sql.Timestamp"/>
	<field name="diernaam" class="java.lang.String"/>
	<field name="geslacht" class="java.lang.String"/>
	<field name="rasnaam" class="java.lang.String"/>

	<variable name="klantnaam" class="java.lang.String" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[$F{voorletters} + " " + $F{achternaam}]]></variableExpression>
	</variable>
