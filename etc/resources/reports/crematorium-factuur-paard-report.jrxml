				</box>
				<textElement>
					<font isBold="true" isUnderline="false" pdfFontName="Helvetica-Bold"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["LET OP! Het te betalen bedrag wordt via een eenmalige incasso van uw bankrekening afgeschreven."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="false">
				<reportElement key="textField-7" x="78" y="701" width="470" height="100">
					<printWhenExpression><![CDATA[new Boolean($F{eenmalige_incasso} == Boolean.FALSE)]]></printWhenExpression>
