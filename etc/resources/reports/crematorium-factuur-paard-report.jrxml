					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA["Deze factuur per omgaande voldoen.\n" +
"Wilt u bij betaling S.V.P. het REKENINGNUMMER vermelden?" +
(($F{eerste_herinnering}!=null)?
"Bij niet voldoen van het faktuurbedrag, zijn wij genoodzaakt van een incassobureau gebruik te maken.":
"")]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement key="staticText-8" x="478" y="572" width="20" height="18">
					<printWhenExpression><![CDATA[new Boolean($F{sieraden}.doubleValue() > 0.001)]]></printWhenExpression>
				</reportElement>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
