	<queryString>
		<![CDATA[SELECT crematorium_facturen.factuur_nummer, naam_bedrijf, aanhef, voorletters, tussenvoegsel, achternaam, straat, huisnummer, postcode, woonplaats, dieren.naam AS diernaam, rassen.naam AS rasnaam, geslacht, geboortedatum, kleur, chip_pasnummer, factuur_datum, eerste_herinnering, tweede_herinnering, administratie_kosten, korting_percentage, korting_bedrag,
       individuele_crematie, btw_percentage, crematorium_prijzen.naam AS crematie_categorie, crematie_datum, crematie_tijd, eenmalige_incasso,
       (crematie_prijs+prijs_individueel) AS crematie_prijs,as_in_urn,as_verstrooing,(kosten_vervoer+extra_vervoer) AS kosten_vervoer,extra_kosten,box,gedenkplaat,sieraden,
       (crematie_prijs+prijs_individueel+as_in_urn+as_verstrooing+kosten_vervoer+extra_vervoer+extra_kosten+box+gedenkplaat+sieraden+administratie_kosten-korting_bedrag) / (btw_percentage+100) * btw_percentage AS totaal_btw,
       (crematie_prijs+prijs_individueel+as_in_urn+as_verstrooing+kosten_vervoer+extra_vervoer+extra_kosten+box+gedenkplaat+sieraden+administratie_kosten-korting_bedrag) AS nog_te_betalen
FROM crematorium_facturen
  JOIN klanten ON crematorium_facturen.klant_id=klanten.klant_id
  LEFT JOIN adres ON klanten.adres_id=adres.adres_id
  JOIN dieren ON crematorium_facturen.crematorium_factuur_id=dieren.crematorium_factuur_id
  LEFT JOIN rassen ON dieren.ras_id=rassen.ras_id
  LEFT JOIN crematorium_prijzen ON crematorium_facturen.crematorium_prijs_id=crematorium_prijzen.crematorium_prijs_id
GROUP BY crematorium_facturen.factuur_nummer, voorletters, achternaam, straat, huisnummer, postcode, woonplaats, factuur_datum, eerste_herinnering, tweede_herinnering, administratie_kosten, korting_percentage, korting_bedrag
HAVING crematorium_facturen.factuur_nummer=$P{crematorium_factuur_id}]]>
	</queryString>
