<?xml version="1.0" encoding="UTF-8"  ?>
<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="keukenrapport-report"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="datum_keukenrapport_van" isForPrompting="true" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="datum_keukenrapport_tot" isForPrompting="true" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="organisatie_naam" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Demopension"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT IF(ISNULL(facturen.factuur_nummer),facturen.reservering_nummer,facturen.factuur_nummer) as factuur_nummer, gereserveerd_tot, dieren.naam AS diernaam, thuis_ochtend, thuis_middag, pension_ochtend, pension_middag, bijzonderheden, medicijnen, product_naam AS wassen, kennel_nummer
FROM facturen
  JOIN factuur_regels ON facturen.factuur_id=factuur_regels.factuur_id
  JOIN dieren ON dieren.dier_id=factuur_regels.dier_id
  LEFT JOIN kennels ON factuur_regels.kennel_id=kennels.kennel_id
  LEFT JOIN voeding ON dieren.voeding_id=voeding.voeding_id
  LEFT JOIN lichaamelijk ON dieren.lichaamelijk_id=lichaamelijk.lichaamelijk_id
  LEFT JOIN factuur_regel_producten ON factuur_regels.factuur_regel_id=factuur_regel_producten.factuur_regel_id AND product_naam='Wassen'
WHERE geannuleerd = false AND 
  (((verbleven_van IS NULL OR year(verbleven_van) < 1000) AND gereserveerd_van<=$P{datum_keukenrapport_tot})
  OR (NOT verbleven_van IS NULL AND year(verbleven_van) > 1000 AND verbleven_van<=$P{datum_keukenrapport_tot}))
AND
  (((verbleven_tot IS NULL OR year(verbleven_tot) < 1000) AND gereserveerd_tot>=$P{datum_keukenrapport_van})
  OR (NOT verbleven_tot IS NULL AND year(verbleven_tot) > 1000 AND verbleven_tot>=$P{datum_keukenrapport_van}))
ORDER BY facturen.factuur_nummer]]></queryString>

	<field name="factuur_nummer" class="java.lang.Long"/>
	<field name="gereserveerd_tot" class="java.sql.Timestamp"/>
	<field name="diernaam" class="java.lang.String"/>
	<field name="thuis_ochtend" class="java.lang.String"/>
	<field name="thuis_middag" class="java.lang.String"/>
	<field name="pension_ochtend" class="java.lang.String"/>
	<field name="pension_middag" class="java.lang.String"/>
	<field name="bijzonderheden" class="java.lang.String"/>
	<field name="medicijnen" class="java.lang.String"/>
	<field name="wassen" class="java.lang.String"/>
	<field name="kennel_nummer" class="java.lang.String"/>

