	<variable name="pin" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$P{kasboek_soort}.equals( "Voldaan" ) ? $F{betaalWijze}.equals( "PIN" ) ? $F{totaalKosten} : null : $F{voorschotBetaalWijze}.equals( "PIN" ) ? $F{voorschot} : null]]></variableExpression>
