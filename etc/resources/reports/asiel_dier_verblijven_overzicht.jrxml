	<parameter name="asiel_dier_id" isForPrompting="false" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(1)]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT asiel_verblijven.verblijf_nummer, asiel_verblijven.opname_datum, asiel_verblijven.vertrek_datum, 
  asiel_opname_soorten.naam AS reden, 
  asiel_dieren.identificatie_nummer, asiel_dieren.naam AS diernaam, 
  brenger.achternaam AS brenger_achternaam, brenger.voorletters AS brenger_voorletters, 
  haler.achternaam AS haler_achternaam, haler.voorletters AS haler_voorletters 
FROM asiel_verblijven 
  INNER JOIN asiel_dieren ON asiel_verblijven.asiel_dier_id=asiel_dieren.asiel_dier_id
  INNER JOIN asiel_opname_soorten ON asiel_verblijven.asiel_opname_soort_id=asiel_opname_soorten.opname_soort_id
  INNER JOIN asiel_eigenaren AS brenger ON asiel_verblijven.eigenaar_in_id=brenger.asiel_eigenaar_id 
  INNER JOIN asiel_eigenaren AS haler ON asiel_verblijven.eigenaar_uit_id=haler.asiel_eigenaar_id 
WHERE asiel_verblijven.asiel_dier_id=$P{asiel_dier_id}]]></queryString>

