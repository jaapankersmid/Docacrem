	<queryString>
		<![CDATA[SELECT shop_facturen.shop_id, shop_facturen.factuur_nummer, naam_bedrijf, aanhef, voorletters, tussenvoegsel, achternaam, straat, huisnummer, postcode, woonplaats, land, factuur_datum, eerste_herinnering, tweede_herinnering, korting_percentage, korting_bedrag, SUM(product_prijs*product_aantal) AS totaal_producten, SUM((product_prijs*product_aantal) / (product_btw+100) * product_btw) AS totaal_btw, (SUM(product_prijs*product_aantal) -  korting_bedrag) AS nog_te_betalen
FROM shop_facturen
  LEFT JOIN klanten ON shop_facturen.klant_id=klanten.klant_id
  LEFT JOIN adres ON klanten.adres_id=adres.adres_id
  LEFT JOIN shop_regel_producten ON shop_facturen.shop_id=shop_regel_producten.shop_id
GROUP BY shop_facturen.shop_id, shop_facturen.factuur_nummer, voorletters, achternaam, straat, huisnummer, postcode, woonplaats, factuur_datum, eerste_herinnering, tweede_herinnering, korting_percentage, korting_bedrag
HAVING shop_facturen.factuur_nummer=$P{shop_id}]]>
	</queryString>
