<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="asiel_kennelrapport_entingen"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="226"
		 pageHeight="842"
		 columnWidth="226"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="registratienr" isForPrompting="true" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(0)]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT inentingen.naam, max(inentingen.begin_datum) AS begin_datum 
FROM asiel_dieren
INNER JOIN lichaamelijk ON asiel_dieren.lichaamelijk_id=lichaamelijk.lichaamelijk_id
INNER JOIN lichaamelijk_inentingen ON lichaamelijk.lichaamelijk_id=lichaamelijk_inentingen.lichaamelijk_id
INNER JOIN inentingen ON lichaamelijk_inentingen.inenting_id=inentingen.inenting_id
WHERE asiel_dieren.identificatie_nummer=$P{registratienr}
GROUP BY inentingen.naam
ORDER BY inentingen.naam]]></queryString>

	<field name="naam" class="java.lang.String"/>
	<field name="begin_datum" class="java.sql.Date"/>

		<background>
			<band height="0"  isSplitAllowed="true" >
			</band>
		</background>
