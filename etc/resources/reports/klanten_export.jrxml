	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="criteriaPeriode" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="titel" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT k.aanhef, k.voorletters, k.tussenvoegsel, k.achternaam, k.email_adres,
  a.straat, a.huisnummer, a.postcode, a.woonplaats, a.land,
  c.telefoonnummer, c.mobielnummer
FROM klanten AS k
INNER JOIN adres AS a ON k.adres_id=a.adres_id
INNER JOIN contact AS c ON k.contact_id=c.contact_id
INNER JOIN facturen AS f ON k.klant_id=f.klant_id
WHERE f.gereserveerd_van LIKE $P{criteriaPeriode}]]></queryString>

