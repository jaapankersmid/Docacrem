<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="kennelrapport-report" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="datum_kennelrapport_van" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="factuurnr_kennelrapport" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Long(6)]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="datum_kennelrapport_tot" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="organisatie_naam" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Demopension"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT creche_contract_regel_id AS factuur_regel_id
FROM creche_contracten as facturen
  JOIN creche_contract_regels as factuur_regels ON facturen.creche_contract_id=factuur_regels.creche_contract_id
WHERE ((contract_periode_van > $P{datum_kennelrapport_van} AND contract_periode_van < $P{datum_kennelrapport_tot}))
  OR facturen.creche_contract_id=$P{factuurnr_kennelrapport}
ORDER BY factuur_regels.creche_contract_regel_id]]>
	</queryString>
	<field name="factuur_regel_id" class="java.lang.Long"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band splitType="Stretch"/>
	</title>
	<pageHeader>
		<band height="21" splitType="Stretch">
			<textField isBlankWhenNull="false">
				<reportElement key="textField-1" x="0" y="0" width="535" height="20"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center">
					<font size="14" isBold="true" pdfFontName="Helvetica-Bold"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Kennelkaart " + $P{organisatie_naam}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement key="line-1" x="0" y="20" width="530" height="1"/>
			</line>
		</band>
	</pageHeader>
	<columnHeader>
		<band splitType="Stretch"/>
	</columnHeader>
	<detail>
		<band height="781" splitType="Stretch">
			<subreport isUsingCache="true">
				<reportElement key="subreport-1" x="0" y="0" width="530" height="779"/>
				<subreportParameter name="SUBREPORT_DIR">
					<subreportParameterExpression><![CDATA[$P{SUBREPORT_DIR}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="factuur_id">
					<subreportParameterExpression><![CDATA[$P{factuurnr_kennelrapport}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="factuur_regel_id">
					<subreportParameterExpression><![CDATA[$F{factuur_regel_id}]]></subreportParameterExpression>
				</subreportParameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression class="java.lang.String"><![CDATA[$P{SUBREPORT_DIR} + "creche-kennelrapport-detail.jasper"]]></subreportExpression>
			</subreport>
		</band>
	</detail>
	<columnFooter>
		<band splitType="Stretch"/>
	</columnFooter>
	<pageFooter>
		<band splitType="Stretch"/>
	</pageFooter>
	<summary>
		<band splitType="Stretch"/>
	</summary>
</jasperReport>
