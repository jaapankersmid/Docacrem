<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="crematorium-dierenarts-vergoeding-dieren" pageWidth="595" pageHeight="802" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="dierenarts_id" class="java.lang.Long">
		<defaultValueExpression><![CDATA[new Long(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="begin_datum" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="eind_datum" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="achtergrond" class="java.lang.Boolean" isForPrompting="false">
		<defaultValueExpression><![CDATA[Boolean.TRUE]]></defaultValueExpression>
	</parameter>
	<parameter name="install_dir" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT dierenarts.naam AS dierenarts_naam, adres.straat AS dierenarts_straat, adres.huisnummer AS dierenarts_huisnummer, adres.postcode AS dierenarts_postcode, adres.woonplaats AS dierenarts_woonplaats, adres.land AS dierenarts_land, dierenarts.bankrekening_nummer AS dierenarts_bank,
  crematorium_facturen.factuur_nummer, crematorium_facturen.factuur_datum, crematorium_facturen.crematie_datum,
  klanten.aanhef, klanten.voorletters, klanten.tussenvoegsel, klanten.achternaam, klant_adres.land, dieren.naam AS diernaam,
  btw_percentage, betalingen.betaal_datum, betalingen.bedrag AS betaald_bedrag,
  dieren.naam as diernaam
FROM dierenarts
INNER JOIN adres ON dierenarts.adres_id=adres.adres_id
INNER JOIN contact ON dierenarts.contact_id=contact.contact_id
INNER JOIN crematorium_facturen ON dierenarts.dierenarts_id=crematorium_facturen.dierenarts_id
INNER JOIN klanten ON crematorium_facturen.klant_id=klanten.klant_id
INNER JOIN adres AS klant_adres ON klanten.adres_id=klant_adres.adres_id
INNER JOIN dieren ON crematorium_facturen.crematorium_factuur_id=dieren.crematorium_factuur_id
INNER JOIN crematorium_factuur_betalingen AS cfb ON crematorium_facturen.crematorium_factuur_id=cfb.crematorium_factuur_id
INNER JOIN betalingen ON cfb.betaling_id=betalingen.betaling_id
WHERE dierenarts.vergoeding IS TRUE
  AND dierenarts.dierenarts_id=$P{dierenarts_id}
  AND betalingen.betaal_datum >= $P{begin_datum}
  AND betalingen.betaal_datum <= $P{eind_datum}
  AND incasso_datum IS NULL]]>
	</queryString>
	<field name="dierenarts_naam" class="java.lang.String"/>
	<field name="dierenarts_straat" class="java.lang.String"/>
	<field name="dierenarts_huisnummer" class="java.lang.String"/>
	<field name="dierenarts_postcode" class="java.lang.String"/>
	<field name="dierenarts_woonplaats" class="java.lang.String"/>
	<field name="dierenarts_land" class="java.lang.String"/>
	<field name="dierenarts_bank" class="java.lang.String"/>
	<field name="factuur_nummer" class="java.lang.Long"/>
	<field name="factuur_datum" class="java.sql.Date"/>
	<field name="crematie_datum" class="java.sql.Date"/>
	<field name="aanhef" class="java.lang.String"/>
	<field name="voorletters" class="java.lang.String"/>
	<field name="tussenvoegsel" class="java.lang.String"/>
	<field name="achternaam" class="java.lang.String"/>
	<field name="land" class="java.lang.String"/>
	<field name="diernaam" class="java.lang.String"/>
	<field name="btw_percentage" class="java.math.BigDecimal"/>
	<field name="betaal_datum" class="java.sql.Timestamp"/>
	<field name="betaald_bedrag" class="java.math.BigDecimal"/>
	<variable name="tot_totaal_prijs" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[($F{dierenarts_land}.equals("Duitsland"))?$F{betaald_bedrag}.subtract($F{btw_percentage}.multiply($F{betaald_bedrag}.divide($F{btw_percentage}.add(new BigDecimal(100.0)), 2, RoundingMode.HALF_UP))).multiply(new BigDecimal(0.9)):$F{betaald_bedrag}]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="tot_vergoeding" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[/*(($F{dierenarts_land}.equals("Duitsland"))?BigDecimal.ZERO:$F{betaald_bedrag}.multiply(new BigDecimal(0.1)))*/
(($F{dierenarts_land}.equals("Duitsland"))?$F{betaald_bedrag}.subtract($F{btw_percentage}.multiply($F{betaald_bedrag}.divide($F{btw_percentage}.add(new BigDecimal(100.0)), 2, RoundingMode.HALF_UP))).multiply(new BigDecimal(0.9)):$F{betaald_bedrag}).multiply(new BigDecimal(0.1))]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="tot_btw" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[($F{dierenarts_land}.equals("Duitsland"))?
BigDecimal.ZERO:
$F{btw_percentage}.multiply($F{betaald_bedrag}.multiply(new BigDecimal(0.1)).divide($F{btw_percentage}.add(new BigDecimal(100.0)), 10, RoundingMode.HALF_UP))]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
