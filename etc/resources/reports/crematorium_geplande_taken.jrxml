	<parameter name="organisatie_naam" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Demopension"]]></defaultValueExpression>
	</parameter>
	<parameter name="gepland_van" isForPrompting="true" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="gepland_tot" isForPrompting="true" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select factuur_nummer, aanhef, voorletters, tussenvoegsel, achternaam, dieren.naam as diernaam, geslacht, kruising, rassen.naam as rasnaam, diersoort.naam as diersoortnaam, plan_datum, datum, tijd, crematorium_handelingen.naam as handeling_naam
from crematorium_handelingen
inner join crematorium_facturen on crematorium_handelingen.crematorium_factuur_id=crematorium_facturen.crematorium_factuur_id
inner join klanten on crematorium_facturen.klant_id=klanten.klant_id
inner join dieren on crematorium_facturen.crematorium_factuur_id=dieren.crematorium_factuur_id
inner join rassen on dieren.ras_id=rassen.ras_id
inner join diersoort on rassen.diersoort_id=diersoort.diersoort_id
where plan_datum = $P{gepland_van} and datum is null
order by handeling_naam, factuur_nummer]]></queryString>

