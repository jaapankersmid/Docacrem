	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="factuur_regel_id" isForPrompting="false" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(0)]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT IF(ISNULL(facturen.factuur_nummer),facturen.reservering_nummer,facturen.factuur_nummer) as factuur_nummer, voorletters, achternaam, gereserveerd_van, gereserveerd_tot, dieren.naam AS diernaam,
       kleur, geslacht, gecastreerd, kruising, geboortedatum, rassen.naam AS rasnaam, laatste_loopsheid_krolsheid, gedrag, eetlust, 
       thuis_ochtend, thuis_middag, thuis_avond, pension_ochtend, pension_middag, pension_avond, bijzonderheden, 
       medicijnen, dosering,
       wassen.product_naam AS wassen, trimmen.product_naam AS trimmen
FROM facturen
  JOIN factuur_regels ON facturen.factuur_id=factuur_regels.factuur_id
  JOIN klanten ON klanten.klant_id=facturen.klant_id
  JOIN dieren ON dieren.dier_id=factuur_regels.dier_id
  LEFT JOIN rassen ON dieren.ras_id=rassen.ras_id
  LEFT JOIN voeding ON dieren.voeding_id=voeding.voeding_id
  LEFT JOIN lichaamelijk ON dieren.lichaamelijk_id=lichaamelijk.lichaamelijk_id
  LEFT JOIN factuur_regel_producten AS wassen ON factuur_regels.factuur_regel_id=wassen.factuur_regel_id AND wassen.product_naam like '%Wassen%'
  LEFT JOIN factuur_regel_producten AS trimmen ON factuur_regels.factuur_regel_id=trimmen.factuur_regel_id AND trimmen.product_naam like '%Trimmen%'
WHERE facturen.geannuleerd = false AND factuur_regels.factuur_regel_id=$P{factuur_regel_id}
ORDER BY facturen.factuur_nummer]]></queryString>

