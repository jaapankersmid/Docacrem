	<parameter name="verblijfNummer" class="java.lang.Long">
		<defaultValueExpression><![CDATA[new Long(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="vraag_soorten" class="java.util.Collection" isForPrompting="false">
		<defaultValueExpression><![CDATA[new LinkedList()]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT asiel_verblijven.verblijf_nummer, asiel_dieren.identificatie_nummer AS dier_nummer, asiel_dieren.naam AS dier_naam, asiel_dieren.geboortedatum, asiel_dieren.gecastreerd, asiel_dieren.kruising, asiel_dieren.geslacht, asiel_dieren.kleur, asiel_dieren.chip_pasnummer,
  rassen.naam as rasnaam, diersoort.naam as diersoortnaam, dier_vachten.naam as vachtnaam,
  asiel_antwoorden.tekst AS antwoord,
  asiel_vragen.tekst AS vraag, asiel_vragen.vraag_soort
FROM asiel_verblijven
INNER JOIN asiel_dieren ON asiel_verblijven.asiel_dier_id=asiel_dieren.asiel_dier_id
INNER JOIN rassen ON asiel_dieren.ras_id=rassen.ras_id
INNER JOIN diersoort ON rassen.diersoort_id=diersoort.diersoort_id
INNER JOIN asiel_verblijf_antwoorden ON asiel_verblijven.asiel_verblijf_id=asiel_verblijf_antwoorden.asiel_verblijf_id
INNER JOIN asiel_antwoorden ON asiel_verblijf_antwoorden.asiel_antwoord_id=asiel_antwoorden.asiel_antwoord_id AND asiel_antwoorden.tekst <> ''
INNER JOIN asiel_vragen ON asiel_antwoorden.asiel_vraag_id=asiel_vragen.asiel_vraag_id
LEFT JOIN dier_vachten ON asiel_dieren.dier_vacht_id=dier_vachten.dier_vacht_id
WHERE $X{IN,vraag_soort,vraag_soorten} AND asiel_verblijven.verblijf_nummer=$P{verblijfNummer}
ORDER BY asiel_vragen.vraag_soort, asiel_vragen.positie]]>
	</queryString>
