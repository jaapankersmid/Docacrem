	</parameter>
	<queryString>
		<![CDATA[SELECT IF(ISNULL(facturen.factuur_nummer),facturen.reservering_nummer,facturen.factuur_nummer) as factuur_nummer, gereserveerd_van, gereserveerd_tot, klanten.achternaam, klanten.voorletters, klanten.tussenvoegsel, klanten.aanhef, dieren.naam AS diernaam, geslacht, rassen.naam AS rasnaam, wassen.product_naam AS wassen, trimmen.product_naam AS trimmen
FROM facturen
  JOIN klanten ON facturen.klant_id=klanten.klant_id
  JOIN factuur_regels ON facturen.factuur_id=factuur_regels.factuur_id
  JOIN dieren ON dieren.dier_id=factuur_regels.dier_id
  JOIN rassen ON rassen.ras_id=dieren.ras_id
  JOIN diersoort ON diersoort.diersoort_id=rassen.diersoort_id
  LEFT JOIN factuur_regel_producten AS wassen ON factuur_regels.factuur_regel_id=wassen.factuur_regel_id AND wassen.product_naam like '%wassen%'
  LEFT JOIN factuur_regel_producten AS trimmen ON factuur_regels.factuur_regel_id=trimmen.factuur_regel_id AND trimmen.product_naam like '%trimmen%'
WHERE geannuleerd = false AND
    (((verbleven_tot IS NULL OR year(verbleven_tot) < 1000) AND gereserveerd_tot > $P{gereserveerd_van} AND gereserveerd_tot < $P{gereserveerd_tot})
 OR (NOT verbleven_tot IS NULL AND year(verbleven_tot) > 1000 AND verbleven_tot > $P{gereserveerd_van} AND verbleven_tot < $P{gereserveerd_tot}))
 AND ($P{diersoort} IS NULL OR $P{diersoort} = ' - ' OR $P{diersoort} = diersoort.naam OR $P{diersoort} = 'Overig' AND diersoort.naam NOT IN ('Hond', 'Kat'))
ORDER BY facturen.factuur_nummer]]>
	</queryString>
	<field name="factuur_nummer" class="java.lang.Long"/>
	<field name="gereserveerd_van" class="java.sql.Timestamp"/>
	<field name="gereserveerd_tot" class="java.sql.Timestamp"/>
	<field name="achternaam" class="java.lang.String"/>
	<field name="voorletters" class="java.lang.String"/>
	<field name="tussenvoegsel" class="java.lang.String"/>
