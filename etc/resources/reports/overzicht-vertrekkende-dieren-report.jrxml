	</parameter>
	<parameter name="gereserveerd_van" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="organisatie_naam" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Demopension"]]></defaultValueExpression>
	</parameter>
	<parameter name="tijd_voor_de_middag" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="tijd_na_de_middag" class="java.lang.String" isForPrompting="false">
