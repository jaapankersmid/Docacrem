				</subreportParameter>
				<subreportParameter name="dierenarts_id">
					<subreportParameterExpression><![CDATA[$F{dierenarts_id}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="begin_datum">
					<subreportParameterExpression><![CDATA[$P{begin_datum}]]></subreportParameterExpression>
				</subreportParameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
