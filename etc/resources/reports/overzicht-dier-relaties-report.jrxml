	<parameter name="gereserveerd_van" isForPrompting="true" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="gereserveerd_tot" isForPrompting="true" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="organisatie_naam" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["Demopension"]]></defaultValueExpression>
	</parameter>
	<parameter name="dier_naam" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="factuur_regel_id" isForPrompting="true" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(0)]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select klant_b.aanhef, klant_b.voorletters, klant_b.tussenvoegsel, klant_b.achternaam, 
  dier_b.naam as dier_naam, dier_b.geslacht, dier_b.gecastreerd, dier_b.kruising,
  ras_b.naam as ras_naam,
  factuur_b.factuur_nummer, factuur_b.gereserveerd_van, factuur_b.gereserveerd_tot 
from facturen as factuur_a
  inner join factuur_regels as regel_a on factuur_a.factuur_id=regel_a.factuur_id
  inner join dieren as dier_a on regel_a.dier_id=dier_a.dier_id
  inner join dier_relaties on dier_a.dier_id=dier_relaties.linker_relatie_id or dier_a.dier_id=dier_relaties.rechter_relatie_id 
  inner join dieren as dier_b on dier_relaties.linker_relatie_id=dier_b.dier_id or dier_relaties.rechter_relatie_id=dier_b.dier_id 
  inner join factuur_regels as regel_b on dier_b.dier_id=regel_b.dier_id
  inner join facturen as factuur_b on regel_b.factuur_id=factuur_b.factuur_id
  inner join klanten as klant_b on dier_b.klant_id=klant_b.klant_id
  inner join rassen as ras_b on dier_b.ras_id=ras_b.ras_id
where regel_a.factuur_regel_id=$P{factuur_regel_id} 
  and dier_a.dier_id <> dier_b.dier_id
  and not factuur_a.gereserveerd_van is null 
  and not factuur_a.gereserveerd_tot is null 
  and not factuur_b.gereserveerd_van is null 
  and not factuur_b.gereserveerd_tot is null 
  and ((factuur_b.gereserveerd_van >= factuur_a.gereserveerd_van and factuur_b.gereserveerd_van <= factuur_a.gereserveerd_tot)
    or (factuur_b.gereserveerd_tot >= factuur_a.gereserveerd_van and factuur_b.gereserveerd_tot <= factuur_a.gereserveerd_tot)
    or (factuur_b.gereserveerd_van <  factuur_a.gereserveerd_van and factuur_b.gereserveerd_tot >  factuur_a.gereserveerd_tot))
order by factuur_b.gereserveerd_van, factuur_b.gereserveerd_tot]]></queryString>

