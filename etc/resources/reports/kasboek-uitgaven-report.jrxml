<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="kasboek-uitgaven-report"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="250"
		 pageHeight="802"
		 columnWidth="250"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="kasboek_id" isForPrompting="false" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="totaal_bank_initieel" isForPrompting="false" class="java.math.BigDecimal">
		<defaultValueExpression ><![CDATA[BigDecimal.ZERO]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT *, (product_prijs*product_aantal) AS product_totaal, ((product_prijs / (100+product_btw)) * product_btw) AS product_btw_totaal 
FROM kasboek_regel_producten 
INNER JOIN kasboek_uitgaven ON kasboek_regel_producten.kasboek_regel_product_id=kasboek_uitgaven.kasboek_regel_product_id 
WHERE kasboek_id=$P{kasboek_id}]]></queryString>

	<field name="kasboek_regel_product_id" class="java.lang.Long"/>
	<field name="product_naam" class="java.lang.String"/>
	<field name="product_omschrijving" class="java.lang.String"/>
	<field name="product_categorie" class="java.lang.String"/>
	<field name="product_btw" class="java.math.BigDecimal"/>
	<field name="product_prijs" class="java.math.BigDecimal"/>
	<field name="product_aantal" class="java.lang.Integer"/>
	<field name="product_betaal_wijze" class="java.lang.String"/>
	<field name="kasboek_id" class="java.lang.Long"/>
	<field name="product_totaal" class="java.math.BigDecimal"/>
	<field name="product_btw_totaal" class="java.math.BigDecimal"/>

	<variable name="btw_totaal" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{product_btw_totaal}]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
		<background>
			<band height="0"  isSplitAllowed="true" >
			</band>
		</background>
		<title>
			<band height="0"  isSplitAllowed="true" >
			</band>
		</title>
		<pageHeader>
			<band height="0"  isSplitAllowed="true" >
			</band>
		</pageHeader>
		<columnHeader>
			<band height="0"  isSplitAllowed="true" >
			</band>
		</columnHeader>
		<detail>
			<band height="20"  isSplitAllowed="true" >
				<textField isStretchWithOverflow="true" isBlankWhenNull="true" evaluationTime="Now" hyperlinkType="None"  hyperlinkTarget="Self" >
					<reportElement
						x="0"
						y="0"
						width="98"
						height="20"
						key="textField-1"/>
					<box></box>
					<textElement verticalAlignment="Middle">
						<font/>
					</textElement>
				<textFieldExpression   class="java.lang.String"><![CDATA[$F{product_naam}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="false" pattern="##0.00" isBlankWhenNull="true" evaluationTime="Now" hyperlinkType="None"  hyperlinkTarget="Self" >
					<reportElement
						x="100"
						y="0"
						width="48"
						height="20"
						key="textField-2">
							<printWhenExpression><![CDATA[new Boolean($F{product_betaal_wijze}.equals("Kas"))]]></printWhenExpression>
						</reportElement>
					<box></box>
					<textElement textAlignment="Right" verticalAlignment="Middle">
						<font/>
					</textElement>
				<textFieldExpression   class="java.math.BigDecimal"><![CDATA[$F{product_totaal}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="false" pattern="##0.00" isBlankWhenNull="true" evaluationTime="Now" hyperlinkType="None"  hyperlinkTarget="Self" >
					<reportElement
						x="151"
						y="0"
						width="48"
						height="20"
						key="textField-3">
							<printWhenExpression><![CDATA[new Boolean($F{product_betaal_wijze}.equals("Bank"))]]></printWhenExpression>
						</reportElement>
					<box></box>
					<textElement textAlignment="Right" verticalAlignment="Middle">
						<font/>
					</textElement>
				<textFieldExpression   class="java.math.BigDecimal"><![CDATA[$F{product_totaal}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="false" pattern="##0.00" isBlankWhenNull="true" evaluationTime="Now" hyperlinkType="None"  hyperlinkTarget="Self" >
					<reportElement
						x="202"
						y="0"
						width="48"
						height="20"
						key="textField-4"/>
					<box></box>
					<textElement textAlignment="Right" verticalAlignment="Middle">
						<font/>
					</textElement>
				<textFieldExpression   class="java.math.BigDecimal"><![CDATA[$F{product_btw_totaal}]]></textFieldExpression>
				</textField>
			</band>
		</detail>
		<columnFooter>
			<band height="0"  isSplitAllowed="true" >
			</band>
		</columnFooter>
		<pageFooter>
