<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="asiel_kennelrapport_vragen"
		 columnCount="2"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="530"
		 pageHeight="842"
		 columnWidth="258"
		 columnSpacing="14"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="asiel_verblijf_id" isForPrompting="true" class="java.lang.Long">
		<defaultValueExpression ><![CDATA[new Long(0)]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT asiel_verblijven.verblijf_nummer, 
       asiel_antwoorden.tekst AS antwoord_tekst, 
       asiel_vragen.tekst AS vraag_tekst
FROM asiel_verblijven
  JOIN asiel_verblijf_antwoorden ON asiel_verblijven.asiel_verblijf_id=asiel_verblijf_antwoorden.asiel_verblijf_id
  JOIN asiel_antwoorden ON asiel_verblijf_antwoorden.asiel_antwoord_id=asiel_antwoorden.asiel_antwoord_id AND NOT asiel_antwoorden.tekst IS NULL AND asiel_antwoorden.tekst <> ''
  JOIN asiel_vragen ON asiel_antwoorden.asiel_vraag_id=asiel_vragen.asiel_vraag_id AND asiel_vragen.print_op_kennelkaart=TRUE
WHERE asiel_verblijven.verblijf_nummer=$P{asiel_verblijf_id} 
ORDER BY asiel_vragen.positie]]></queryString>

	<field name="verblijf_nummer" class="java.lang.Long"/>
	<field name="antwoord_tekst" class="java.lang.String"/>
	<field name="vraag_tekst" class="java.lang.String"/>

		<background>
			<band height="0"  isSplitAllowed="true" >
			</band>
		</background>
		<title>
			<band height="0"  isSplitAllowed="true" >
			</band>
		</title>
		<pageHeader>
			<band height="0"  isSplitAllowed="true" >
			</band>
		</pageHeader>
		<columnHeader>
			<band height="0"  isSplitAllowed="true" >
			</band>
		</columnHeader>
		<detail>
			<band height="20"  isSplitAllowed="true" >
				<textField isStretchWithOverflow="true" isBlankWhenNull="true" evaluationTime="Now" hyperlinkType="None"  hyperlinkTarget="Self" >
					<reportElement
						x="0"
						y="0"
						width="90"
						height="20"
						key="textField-1"/>
					<box>					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
</box>
					<textElement verticalAlignment="Top">
						<font/>
					</textElement>
				<textFieldExpression   class="java.lang.String"><![CDATA[$F{vraag_tekst}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true" evaluationTime="Now" hyperlinkType="None"  hyperlinkTarget="Self" >
					<reportElement
						x="110"
						y="0"
						width="150"
						height="20"
						key="textField-2"/>
					<box>					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
</box>
					<textElement verticalAlignment="Top">
						<font/>
					</textElement>
				<textFieldExpression   class="java.lang.String"><![CDATA[$F{antwoord_tekst}]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement
						x="90"
						y="0"
						width="20"
						height="20"
						key="staticText-1">
							<printWhenExpression><![CDATA[new Boolean($F{vraag_tekst} != null)]]></printWhenExpression>
						</reportElement>
					<box>					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
</box>
					<textElement textAlignment="Center" verticalAlignment="Top">
						<font/>
					</textElement>
				<text><![CDATA[:]]></text>
				</staticText>
			</band>
		</detail>
		<columnFooter>
			<band height="0"  isSplitAllowed="true" >
