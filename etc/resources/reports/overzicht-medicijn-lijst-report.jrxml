	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="datum_medicijn_lijst_van" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="datum_medicijn_lijst_tot" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="organisatie_naam" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Demopension"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select f.factuur_id, IF(ISNULL(f.factuur_nummer),f.reservering_nummer,f.factuur_nummer) as factuur_nummer,
  klant.aanhef, klant.voorletters, klant.tussenvoegsel, klant.achternaam,
  dier.naam as diernaam, dier.geslacht,
  ras.naam as rasnaam,
  medicijn.naam as medicijn, medicijn.begin_datum, medicijn.eind_datum,
  medicijn.dosering_ochtend, medicijn.dosering_middag,
  medicijn.aantal_ochtend, medicijn.aantal_middag
from pension_bezetting as pb
inner join facturen as f on pb.factuur_id = f.factuur_id
inner join dieren as dier on pb.dier_id = dier.dier_id
inner join rassen as ras on dier.ras_id = ras.ras_id
inner join klanten as klant on dier.klant_id = klant.klant_id
inner join lichaamelijk on dier.lichaamelijk_id = lichaamelijk.lichaamelijk_id
inner join lichaamelijk_medicijnen as lm on lichaamelijk.lichaamelijk_id = lm.lichaamelijk_id
inner join medicijnen as medicijn on lm.medicijn_id = medicijn.medicijn_id
where pb.gereserveerd_van < $P{datum_medicijn_lijst_tot}
and pb.gereserveerd_tot >= $P{datum_medicijn_lijst_van}
and (pb.gereserveerd_van <= medicijn.begin_datum and pb.gereserveerd_tot >= medicijn.begin_datum
  or pb.gereserveerd_van <= medicijn.eind_datum and pb.gereserveerd_tot >= medicijn.eind_datum
  or pb.gereserveerd_van > medicijn.begin_datum and pb.gereserveerd_tot < medicijn.eind_datum)
order by f.factuur_nummer, diernaam, medicijn]]>
	</queryString>
	<field name="factuur_id" class="java.lang.Long"/>
	<field name="factuur_nummer" class="java.lang.Long"/>
	<field name="aanhef" class="java.lang.String"/>
	<field name="voorletters" class="java.lang.String"/>
	<field name="tussenvoegsel" class="java.lang.String"/>
	<field name="achternaam" class="java.lang.String"/>
