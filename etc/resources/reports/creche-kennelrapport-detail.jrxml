	<parameter name="factuur_regel_id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Long(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="factuur_id" class="java.lang.Long" isForPrompting="false">
		<defaultValueExpression><![CDATA[0L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT facturen.contract_nummer as factuur_nummer, klanten.voorletters, klanten.achternaam, contract_periode_van AS gereserveerd_van, contract_periode_tot AS gereserveerd_tot, dieren.naam AS diernaam, dieren.dier_id,
       kleur, geslacht, gecastreerd, kruising, geboortedatum, chip_pasnummer, rassen.naam AS rasnaam, laatste_loopsheid_krolsheid, gedrag, eetlust,
       thuis_ochtend, thuis_middag, thuis_avond, pension_ochtend, pension_middag, pension_avond, bijzonderheden,
       medicijnen, dosering,
       adres.straat, adres.huisnummer, adres.postcode, adres.woonplaats, contact.telefoonnummer, contact.mobielnummer,
       planning_maandag, planning_dinsdag, planning_woensdag, planning_donderdag, planning_vrijdag, planning_zaterdag, planning_zondag
FROM creche_contracten AS facturen
  JOIN creche_contract_regels AS factuur_regels ON facturen.creche_contract_id=factuur_regels.creche_contract_id
  JOIN klanten ON klanten.klant_id=facturen.klant_id
  JOIN adres ON klanten.adres_id=adres.adres_id
  JOIN contact ON klanten.contact_id=contact.contact_id
  JOIN dieren ON dieren.dier_id=factuur_regels.dier_id
  LEFT JOIN rassen ON dieren.ras_id=rassen.ras_id
  LEFT JOIN voeding ON dieren.voeding_id=voeding.voeding_id
  LEFT JOIN lichaamelijk ON dieren.lichaamelijk_id=lichaamelijk.lichaamelijk_id
  WHERE factuur_regels.creche_contract_regel_id=$P{factuur_regel_id}
ORDER BY creche_contract_regel_id]]>
	</queryString>
