	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="asiel_dier_id" class="java.lang.Long">
		<defaultValueExpression><![CDATA[new Long(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="organisatie_naam" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Demopension"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT asiel_dieren.identificatie_nummer AS registratienr, asiel_dieren.naam AS diernaam, asiel_dieren.geslacht, asiel_dieren.kleur, asiel_dieren.chip_pasnummer, asiel_dieren.geboortedatum,
       rassen.naam AS rasnaam,
       inentingen.naam AS behandeling_naam, inentingen.merk, inentingen.begin_datum, inentingen.eind_datum, '' AS omschrijving
FROM asiel_dieren
INNER JOIN rassen ON asiel_dieren.ras_id=rassen.ras_id
INNER JOIN lichaamelijk ON asiel_dieren.lichaamelijk_id=lichaamelijk.lichaamelijk_id
INNER JOIN lichaamelijk_inentingen ON lichaamelijk.lichaamelijk_id=lichaamelijk_inentingen.lichaamelijk_id
INNER JOIN inentingen ON lichaamelijk_inentingen.inenting_id=inentingen.inenting_id
WHERE asiel_dieren.asiel_dier_id=$P{asiel_dier_id}

UNION

SELECT asiel_dieren.identificatie_nummer AS registratienr, asiel_dieren.naam AS diernaam, asiel_dieren.geslacht, asiel_dieren.kleur, asiel_dieren.chip_pasnummer, asiel_dieren.geboortedatum,
       rassen.naam AS rasnaam,
       medische_handelingen.naam AS behandeling_naam, medische_handelingen.merk, medische_handelingen.begin_datum, medische_handelingen.eind_datum, medische_handelingen.omschrijving
FROM asiel_dieren
INNER JOIN rassen ON asiel_dieren.ras_id=rassen.ras_id
INNER JOIN lichaamelijk ON asiel_dieren.lichaamelijk_id=lichaamelijk.lichaamelijk_id
INNER JOIN lichaamelijk_ontvlooid_ontwormd ON lichaamelijk.lichaamelijk_id=lichaamelijk_ontvlooid_ontwormd.lichaamelijk_id
INNER JOIN medische_handelingen ON lichaamelijk_ontvlooid_ontwormd.medische_handeling_id=medische_handelingen.medische_handeling_id
WHERE asiel_dieren.asiel_dier_id=$P{asiel_dier_id}

UNION

SELECT asiel_dieren.identificatie_nummer AS registratienr, asiel_dieren.naam AS diernaam, asiel_dieren.geslacht, asiel_dieren.kleur, asiel_dieren.chip_pasnummer, asiel_dieren.geboortedatum,
       rassen.naam AS rasnaam,
       medische_handelingen.naam AS behandeling_naam, medische_handelingen.merk, medische_handelingen.begin_datum, medische_handelingen.eind_datum, medische_handelingen.omschrijving
FROM asiel_dieren
INNER JOIN rassen ON asiel_dieren.ras_id=rassen.ras_id
INNER JOIN lichaamelijk ON asiel_dieren.lichaamelijk_id=lichaamelijk.lichaamelijk_id
INNER JOIN lichaamelijk_medische_handelingen ON lichaamelijk.lichaamelijk_id=lichaamelijk_medische_handelingen.lichaamelijk_id
INNER JOIN medische_handelingen ON lichaamelijk_medische_handelingen.medische_handeling_id=medische_handelingen.medische_handeling_id
WHERE asiel_dieren.asiel_dier_id=$P{asiel_dier_id}

UNION

SELECT asiel_dieren.identificatie_nummer AS registratienr, asiel_dieren.naam AS diernaam, asiel_dieren.geslacht, asiel_dieren.kleur, asiel_dieren.chip_pasnummer, asiel_dieren.geboortedatum,
       rassen.naam AS rasnaam,
       medicijnen.naam AS behandeling_naam, '' AS merk, medicijnen.begin_datum, medicijnen.eind_datum, medicijnen.omschrijving
FROM asiel_dieren
INNER JOIN rassen ON asiel_dieren.ras_id=rassen.ras_id
INNER JOIN lichaamelijk ON asiel_dieren.lichaamelijk_id=lichaamelijk.lichaamelijk_id
INNER JOIN lichaamelijk_medicijnen ON lichaamelijk.lichaamelijk_id=lichaamelijk_medicijnen.lichaamelijk_id
INNER JOIN medicijnen ON lichaamelijk_medicijnen.medicijn_id=medicijnen.medicijn_id
WHERE asiel_dieren.asiel_dier_id=$P{asiel_dier_id}

ORDER BY begin_datum]]>
	</queryString>
