<?xml version="1.0" encoding="UTF-8"?>

<overzichtModel>
	<naam>Overzicht Wegen</naam>
	<query>
FROM (SELECT f.*, fr.dier_id, fr.weeg_soort_id, (SELECT sum(b.bedrag) FROM betalingen AS b INNER JOIN pension_reservering_betalingen AS prb ON b.betaling_id = prb.betaling_id WHERE prb.factuur_id = f.factuur_id) AS totaal_betalingen FROM facturen AS f :f.where) AS f
JOIN klanten AS k ON f.klant_id = k.klant_id
JOIN weeg_soorten AS bs ON bs.weeg_soort_id = f.weeg_soort_id
JOIN dieren AS d ON d.dier_id = f.dier_id
JOIN rassen AS r ON r.ras_id = d.ras_id
JOIN diersoort AS ds ON ds.diersoort_id = r.diersoort_id
	</query>
	<velden>
		<veld>
			<naam>f.factuur_id</naam>
			<label>ID</label>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>trim(replace(concat_ws(' ',k.naam_bedrijf,k.aanhef,k.voorletters,k.tussenvoegsel,k.achternaam),'  ',' '))</naam>
			<label>Klant</label>
			<visible>true</visible>
			<order_column>k.achternaam</order_column>
		</veld>
		<veld>
			<naam>d.naam</naam>
			<label>Dier</label>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>ds.naam</naam>
			<label>Diersoort</label>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>r.naam</naam>
			<label>Ras</label>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>IF(d.geslacht = 'Mannelijk','M',IF(d.geslacht = 'Vrouwelijk','V','?'))</naam>
			<label>Geslacht</label>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>IF(d.gecastreerd,'Ja','Nee')</naam>
			<label>Gecastreerd</label>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>d.kleur</naam>
			<label>Kleur</label>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>(SELECT dg.gewicht FROM dier_gewicht AS dg WHERE dg.dier_id = d.dier_id ORDER BY dg.datum DESC LIMIT 1)</naam>
			<label>Gewicht</label>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>IF(ISNULL(f.factuur_nummer),f.reservering_nummer,f.factuur_nummer)</naam>
			<label>Factuurnr.</label>
			<visible>true</visible>
		</veld>
        <veld>
            <naam>f.opmerking</naam>
            <label>Opmerkingen</label>
            <visible>false</visible>
            <type>multiline</type>
        </veld>
		<veld>
			<naam>f.gereserveerd_van</naam>
			<label>Gereserveerd van</label>
			<type>date</type>
			<format>d MMM yyyy VM</format>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>f.gereserveerd_tot</naam>
			<label>Gereserveerd tot</label>
			<type>date</type>
			<format>d MMM yyyy NM</format>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>f.verbleven_van</naam>
			<label>Verbleven van</label>
			<type>date</type>
			<format>d MMM yyyy VM</format>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>f.verbleven_tot</naam>
			<label>Verbleven tot</label>
			<type>date</type>
			<format>d MMM yyyy NM</format>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>datediff(f.gereserveerd_tot,f.gereserveerd_van)</naam>
			<label>Nachten</label>
            <type>integer</type>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>(SELECT group_concat(concat(s.naam, ' - ', k.kennel_nummer) ORDER BY s.naam ASC, k.kennel_nummer ASC separator '; ') AS kennels FROM kennels AS k JOIN sectoren AS s ON k.sector_id = s.sector_id JOIN kennel_verblijf AS kv ON k.kennel_id = kv.kennel_id WHERE (kv.factuur_id = f.factuur_id AND kv.dier_id = d.dier_id))</naam>
			<label>Kennel</label>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>f.hdov_id</naam>
			<label>HDOV.nr.</label>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>f.factuur_datum</naam>
			<label>Factuur datum</label>
			<type>date</type>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>f.eerste_herinnering</naam>
			<label>1e Herinnering</label>
			<type>date</type>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>f.tweede_herinnering</naam>
			<label>2e Herinnering</label>
			<type>date</type>
			<visible>false</visible>
		</veld>
	</velden>
</overzichtModel>
