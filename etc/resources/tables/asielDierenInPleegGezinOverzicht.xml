<?xml version="1.0" encoding="UTF-8"?>

<overzichtModel>
	<naam>Overzicht Dieren in Pleeggezin</naam>
	<query>
FROM (SELECT v.* FROM asiel_verblijven AS v :f.where) AS v
JOIN asiel_dieren AS d ON v.asiel_dier_id = d.asiel_dier_id
JOIN pleeg_gezin_verblijven AS pgv ON v.asiel_verblijf_id = pgv.asiel_verblijf_id AND pgv.tot_datum IS NULL
JOIN asiel_eigenaren AS ae ON pgv.asiel_eigenaar_id = ae.asiel_eigenaar_id
LEFT JOIN rassen AS r ON d.ras_id = r.ras_id
LEFT JOIN diersoort AS s ON r.diersoort_id = s.diersoort_id
LEFT JOIN asiel_opname_soorten AS i ON v.asiel_opname_soort_id = i.opname_soort_id
	</query>
	<velden>
		<veld>
			<naam>v.asiel_verblijf_id</naam>
			<label>ID</label>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>CONCAT('V',v.verblijf_nummer)</naam>
			<label>V.nr.</label>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>replace(concat_ws(' ',ae.aanhef,ae.voorletters,ae.tussenvoegsel,ae.achternaam),'  ',' ')</naam>
			<label>Pleeggezin</label>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>d.identificatie_nummer</naam>
			<label>Identificatienr.</label>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>d.naam</naam>
			<label>Dier</label>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>s.naam</naam>
			<label>Diersoort</label>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>concat(r.naam,IF(d.kruising,' (kr.)',''))</naam>
			<label>Ras</label>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>IF(d.geslacht = 'Mannelijk','M',IF(d.geslacht = 'Vrouwelijk','V','?'))</naam>
			<label>Geslacht</label>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>(SELECT vacht.naam FROM dier_vachten AS vacht WHERE vacht.dier_vacht_id = d.dier_vacht_id)</naam>
			<label>Vacht</label>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>d.kleur</naam>
			<label>Kleur</label>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>i.naam</naam>
			<label>In</label>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>v.opname_datum</naam>
			<label>Datum in</label>
			<type>date</type>
			<format>d MMM yyyy</format>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>pgv.van_datum</naam>
			<label>Datum in gezin</label>
			<type>date</type>
			<format>d MMM yyyy</format>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>TO_DAYS(curdate()) - TO_DAYS(pgv.van_datum) + 1</naam>
			<label># Dagen</label>
			<type>integer</type>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>pgv.opmerkingen</naam>
			<label>Opmerkingen</label>
			<type>multiline</type>
			<visible>false</visible>
		</veld>
	</velden>
</overzichtModel>
