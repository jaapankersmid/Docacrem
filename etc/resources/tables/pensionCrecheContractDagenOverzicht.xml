<?xml version="1.0" encoding="UTF-8"?>

<overzichtModel>
	<naam>Overzicht Crèche Contract Dagen</naam>
	<query>
FROM (SELECT f.* FROM creche_contracten AS f JOIN creche_reservering AS cr_ ON cr_.creche_contract_id = f.creche_contract_id :f.where) AS cc
JOIN creche_contract_regels AS ccr ON ccr.creche_contract_id = cc.creche_contract_id
JOIN klanten AS k ON k.klant_id = cc.klant_id
JOIN dieren AS d ON d.dier_id = ccr.dier_id
LEFT JOIN rassen AS r ON r.ras_id = d.ras_id
LEFT JOIN diersoort AS ds ON ds.diersoort_id = r.diersoort_id
	</query>
	<group>true</group>
	<velden>
		<veld>
			<naam>cc.creche_contract_id</naam>
			<label>ID</label>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>trim(replace(concat_ws(' ',k.naam_bedrijf,k.aanhef,k.voorletters,k.tussenvoegsel,k.achternaam),'  ',' '))</naam>
			<label>Klant</label>
			<visible>true</visible>
			<order_column>k.achternaam</order_column>
		</veld>
		<veld>
			<naam>(SELECT kleur.naam FROM kleur_codes AS kleur WHERE kleur.kleur_code_id = k.kleur_code_id)</naam>
			<label>Kleurcode (Klant)</label>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>d.naam</naam>
			<label>Dier</label>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>ds.naam</naam>
			<label>Diersoort</label>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>r.naam</naam>
			<label>Ras</label>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>d.geslacht</naam>
			<label>Geslacht</label>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>d.gecastreerd</naam>
			<label>Gecastreerd</label>
			<type>boolean</type>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>d.kleur</naam>
			<label>Kleur</label>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>(SELECT dk.naam FROM dier_kleur_codes AS dk WHERE dk.dier_kleur_code_id = d.dier_kleur_code_id)</naam>
			<label>Kleurcode (Dier)</label>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>d.geboortedatum</naam>
			<label>Geboortedatum</label>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>cc.contract_nummer</naam>
			<label>Contractnr.</label>
			<visible>true</visible>
		</veld>
        <veld>
            <naam>cc.opmerking</naam>
            <label>Opmerkingen</label>
            <visible>false</visible>
            <type>multiline</type>
        </veld>
		<veld>
			<naam>cc.contract_periode_van</naam>
			<label>Contract van</label>
			<type>date</type>
			<format>d MMM yyyy</format>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>cc.contract_periode_tot</naam>
			<label>Contract tot</label>
			<type>date</type>
			<format>d MMM yyyy</format>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>cc.actief</naam>
			<label>Actief</label>
			<type>boolean</type>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>ccr.planning_maandag</naam>
			<label>Maandag</label>
			<type>boolean</type>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>ccr.planning_dinsdag</naam>
			<label>Dinsdag</label>
			<type>boolean</type>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>ccr.planning_woensdag</naam>
			<label>Woensdag</label>
			<type>boolean</type>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>ccr.planning_donderdag</naam>
			<label>Donderdag</label>
			<type>boolean</type>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>ccr.planning_vrijdag</naam>
			<label>Vrijdag</label>
			<type>boolean</type>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>ccr.planning_zaterdag</naam>
			<label>Zaterdag</label>
			<type>boolean</type>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>ccr.planning_zondag</naam>
			<label>Zondag</label>
			<type>boolean</type>
			<visible>true</visible>
		</veld>
	</velden>
</overzichtModel>
