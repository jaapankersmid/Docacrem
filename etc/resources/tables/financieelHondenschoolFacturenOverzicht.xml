<?xml version="1.0" encoding="UTF-8"?>

<overzichtModel>
	<naam>Hondenschool Facturen</naam>
	<query>
FROM (SELECT f.*, (IF(ISNULL((SELECT sum(b.bedrag) FROM betalingen AS b INNER JOIN hondenschool_factuur_betalingen AS hfb ON b.betaling_id = hfb.betaling_id WHERE hfb.hondenschool_factuur_id = f.hondenschool_factuur_id)),0,(SELECT sum(b.bedrag) FROM betalingen AS b INNER JOIN hondenschool_factuur_betalingen AS hfb ON b.betaling_id = hfb.betaling_id WHERE hfb.hondenschool_factuur_id = f.hondenschool_factuur_id))) AS totaal_betalingen FROM hondenschool_facturen AS f :f.where) AS f
JOIN klanten AS k ON f.klant_id = k.klant_id
	</query>
	<group>true</group>
	<velden>
		<veld>
			<naam>f.hondenschool_factuur_id</naam>
			<label>ID</label>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>trim(replace(concat_ws(' ',k.naam_bedrijf,k.aanhef,k.voorletters,k.tussenvoegsel,k.achternaam),'  ',' '))</naam>
			<label>Klant</label>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>f.factuur_nummer</naam>
			<label>Factuurnr.</label>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>f.cursus_datum</naam>
			<label>Cursusdatum</label>
			<type>date</type>
			<format>d MMM yyyy</format>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>f.factuur_datum</naam>
			<label>Factuur datum</label>
			<type>date</type>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>f.eerste_herinnering</naam>
			<label>1e Herinnering</label>
			<type>date</type>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>f.tweede_herinnering</naam>
			<label>2e Herinnering</label>
			<type>date</type>
			<visible>false</visible>
		</veld>
		<veld>
			<naam>f.korting_bedrag</naam>
			<label>Korting</label>
			<type>valuta</type>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>f.totaal_betalingen</naam>
			<label>Betaald</label>
			<type>valuta</type>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>f.cursus_prijs + f.extra_kosten - (f.korting_bedrag) - f.totaal_betalingen</naam>
			<label>Openstaand</label>
			<type>valuta</type>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>f.cursus_prijs + f.extra_kosten - (f.korting_bedrag)</naam>
			<label>Bedrag</label>
			<type>valuta</type>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>f.cursus_prijs + f.extra_kosten - (f.korting_bedrag) - (sum(((f.cursus_prijs + f.extra_kosten)) / (100 + f.btw_percentage) * f.btw_percentage)) * (1 - (f.korting_bedrag) / (f.cursus_prijs + f.extra_kosten))</naam>
			<label>Excl. BTW</label>
			<type>valuta</type>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>(sum(((f.cursus_prijs + f.extra_kosten)) / (100 + f.btw_percentage) * f.btw_percentage)) * (1 - (f.korting_bedrag) / (f.cursus_prijs + f.extra_kosten))</naam>
			<label>BTW</label>
			<type>valuta</type>
			<visible>true</visible>
		</veld>
		<veld>
			<naam>f.cursus_prijs + f.extra_kosten - (f.korting_bedrag) - f.totaal_betalingen</naam>
			<label>openstaand_bedrag</label>
			<type>valuta</type>
			<visible>false</visible>
			<property>true</property>
		</veld>
	</velden>
</overzichtModel>
