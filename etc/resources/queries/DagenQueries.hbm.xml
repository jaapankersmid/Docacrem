<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd" >

<hibernate-mapping>

    <query name="dagen.selectByDatumExpressie">
        <![CDATA[from Dag as d where d.datum >= :BeginDatum and d.datum <= :EindDatum]]>
    </query>

</hibernate-mapping>
