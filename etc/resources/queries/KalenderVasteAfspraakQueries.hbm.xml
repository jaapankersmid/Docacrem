<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd" >

<hibernate-mapping>

    <query name="kalender_vaste_afspraak.selectByDagVanDeWeek">
        <![CDATA[from KalenderVasteAfspraak as d 
				where d.dagVanDeWeek = :DagVanDeWeek]]>
    </query>

</hibernate-mapping>
